{
  "name": "n8n-from-scratch",
  "version": "0.1.0",
  "description": "A from-scratch, engine-first clone of n8n's core workflow model",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "server": "tsx src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  }
}
